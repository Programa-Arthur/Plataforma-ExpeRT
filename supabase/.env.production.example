# Copie para supabase/.env.production e preencha.
# NUNCA versione o arquivo .env.production (já está no .gitignore).
#
#   cp supabase/.env.production.example supabase/.env.production
#
# Depois grave na Supabase:
#   npx supabase secrets set --project-ref xoacnxclwytocrubapap \
#     --env-file supabase/.env.production

MONGODB_URI="mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net"
MONGODB_DATABASE="ExpeRT"
MONGODB_USERS_COLLECTION="users"

# Senha do painel administrativo (admin.html).
ADMIN_PASSWORD="troque-esta-senha"

# Chave usada para assinar o token do painel (gere com: openssl rand -hex 32).
ADMIN_SESSION_SECRET="troque-esta-chave"

# Origem autorizada do site (opcional; vazio = qualquer origem).
SITE_ORIGIN=""

# Endereço público do site (opcional; usado no redirect da raiz).
SITE_URL=""
